#!/usr/bin/env node
import fs from 'node:fs';

const args = process.argv.slice(2);
if (process.env.FAKE_COPILOT_CALLS) fs.appendFileSync(process.env.FAKE_COPILOT_CALLS, JSON.stringify({ args, cwd: process.cwd() }) + '\n');
if (args.includes('--help')) {
  console.log('--prompt --output-format --deny-tool');
} else if (args.includes('--prompt')) {
  console.log('Fake Copilot completed the isolated task.');
} else {
  process.exitCode = 2;
}
